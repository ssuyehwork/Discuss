QListWidget {
    background-color: #252526;
    color: #CCC;
    border: 1px solid #333;
    border-right: 1px solid #333;
    outline: none;
    padding: 4px;
    border-radius: 6px;
}

QStackedWidget {
    background-color: #1E1E1E;
    border: none;
}

QMainWindow {
    background-color: #1E1E1E;
    color: #EEEEEE;
}

QDialog {
    background-color: #1E1E1E;
    color: #EEEEEE;
}

QLabel {
    color: #CCCCCC;
}

QWidget#CentralWidget {
    background-color: #1E1E1E;
}

#TitleBar {
    background-color: #1E1E1E;
    border-bottom: 1px solid #333333;
}

QWidget#TabBarWidget {
    background: transparent;
    border: none;
}

QPushButton#NewTabBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    outline: none;
}

QPushButton#NewTabBtn:hover {
    background-color: #3E3E42;
}

QWidget#TabItem {
    background-color: #1E1E1E;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid transparent;
    border-bottom: none;
}

QWidget#TabItem:hover {
    background-color: #252526;
}

QWidget#TabItem[active="true"] {
    background-color: #2D2D2D;
    border: 1px solid #3E3E42;
    border-bottom: none;
}

QLabel#TabIconLabel {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

QLabel#TabTitleLabel {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
    color: #AAAAAA;
    font-size: 12px;
}

QLabel#TabTitleLabel[active="true"] {
    color: #FFFFFF;
}

QPushButton#TabCloseBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px;
    outline: none;
}

QPushButton#TabCloseBtn:hover {
    background-color: #555555;
}

QSplitter {
    background: transparent;
    border: none;
}

QPushButton#MetaPanelColorBtn {
    border-radius: 8px;
    border: 1px solid transparent;
}

QPushButton#MetaPanelColorBtn:hover {
    border-color: #FFFFFF;
}

QPushButton#MetaPanelColorBtn[active="true"] {
    border: 2px solid #FFFFFF;
}

QPushButton#MetaRatingColorBtn {
    border-radius: 9px;
    border: none;
}

QTreeView#NavTreeView::branch {
    width: 20px;
}

QSplitter::handle:horizontal {
    background-color: #1E1E1E;
    width: 5px;
}

QSplitter::handle:horizontal:hover {
    background-color: #378ADD;
}

#SidebarContainer {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 0px;
    color: #EEEEEE;
    margin: 0px;
    padding: 0px;
}

#SidebarContainerWidget {
    background-color: #1E1E1E;
