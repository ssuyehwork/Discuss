}

QPushButton#TitleControlBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
    outline: none;
}

QPushButton#TitleControlBtn:focus {
    outline: none;
    border: none;
}

QPushButton#TitleControlBtn:hover {
    background: #3E3E42;
}

QPushButton#TitleControlBtn:pressed {
    background: #4E4E52;
}

QPushButton#TitleCloseBtn {
    background-color: #e81123;
