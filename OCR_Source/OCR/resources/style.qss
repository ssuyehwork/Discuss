    background-color: transparent;
    border: none;
    border-radius: 4px;
}

#PathChip:hover {
    background-color: #3e3e42;
}

QWidget#rnwCard {
    background-color: #1E1E1E;
    border-radius: 10px;
    border: 1px solid #383838;
}

QWidget#iqpCard {
    background-color: #1E1E1E;
    border-radius: 10px;
    border: 1px solid #383838;
}

QLineEdit#iqpSearch {
    background-color: #252526;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 5px 10px 5px 32px;
    color: #E8E8E8;
    font-size: 13px;
}

QLineEdit#iqpSearch:focus {
    border-color: #4a90e2;
    background-color: #2A2A2A;
}

QLineEdit#iqpSearch::placeholder {
    color: #555;
}

QListWidget#iqpList {
    background: transparent;
    border: none;
    outline: none;
    color: #CCC;
}

QListWidget#iqpList::item {
    border-bottom: 1px solid #252525;
    padding: 4px 6px;
    border-radius: 5px;
}

QListWidget#iqpList::item:hover {
    background-color: #2A2D30;
}

QListWidget#iqpList::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}

QScrollBar::handle:vertical {
    background: #444;
    min-height: 24px;
    border-radius: 2px;
}

QScrollBar::add-line:vertical {
    width: 0px;
    height: 0;
}

QScrollBar::sub-line:vertical {
    width: 0px;
    height: 0;
}

QScrollBar::add-page:vertical {
    background: none;
}

QScrollBar::sub-page:vertical {
    background: none;
}

#IdeaQuickPanel_iconLabel_2 {
    color: #3A90FF;
    font-size: 14px;
    background: transparent;
    border: none;
}

#IdeaQuickPanel_m_countLabel_3 {
    color: #555;
    font-size: 11px;
    background: transparent;
    border: none;
}

#IdeaQuickPanel_hintLabel_4 {
    color: #3A3A3A;
    font-size: 10px;
    background: transparent;
    border: none;
}

#ScreenshotToolbar {
    background: transparent;
}

#ScreenshotToolbar #MainContainer {
    background-color: #2D2D2D;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
}

#ScreenshotToolbar #ToolRow {
    background: transparent;
}

#ScreenshotToolbar #OptionWidget {
    background: transparent;
}

#ScreenshotToolbar QPushButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

#ScreenshotToolbar #MainContainer QPushButton:hover {
    background-color: #3e3e42;
}

#ScreenshotToolbar #MainContainer QPushButton:checked {
    background-color: #3e3e42;
}

#ScreenshotToolbar QPushButton[colorBtn="true"] {
    padding: 0px;
    border-radius: 2px;
}

#ScreenshotToolbar QPushButton[sizeBtn="true"] {
    background-color: #777;
    border-radius: 50%;
}

#ScreenshotToolbar QPushButton[sizeBtn="true"]:checked {
    background-color: #007ACC;
}

#ColorPickerWindow {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    color: #E0E0E0;
}

#ColorPickerWindow QLineEdit {
    background-color: #2A2A2A;
    border: 1px solid #444;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 4px;
    font-weight: bold;
}

#ColorPickerWindow QLineEdit:focus {
    border: 1px solid #3b8ed0;
}

#ColorPickerWindow QPushButton {
    background-color: #333;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 6px;
    outline: none;
}

#ColorPickerWindow QPushButton:hover {
    background-color: #3e3e42;
}

#ColorPickerWindow QPushButton:pressed {
    background-color: #222;
}

#ColorPickerWindow QScrollArea {
    background: transparent;
    border: none;
}

#ColorPickerWindow QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

#ColorPickerWindow QScrollBar::handle:vertical {
    background: #444;
    border-radius: 4px;
    min-height: 20px;
}

#ColorPickerWindow QScrollBar::handle:vertical:hover {
    background: #555;
}

#ColorPickerWindow QScrollBar::add-line:vertical {
    height: 0px;
}

#ColorPickerWindow QScrollBar::sub-line:vertical {
    height: 0px;
}

#ColorPickerNavBtn {
    background: #333;
    border-radius: 6px;
    font-weight: bold;
    border: 1px solid #444;
}

#ColorPickerNavBtn:hover {
    background: #444;
}

#ColorPickerNavBtn:checked {
    background: #007ACC;
    color: white;
    border-color: #007ACC;
}

#ColorPickerSpinBtn {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

#ColorPickerSpinBtn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
}

QFrame#rulerToolbar {
    background: #1e1e1e;
    border-radius: 8px;
    border: 1px solid #444;
}

QFrame#rulerToolbar QPushButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 8px;
}

QFrame#rulerToolbar QPushButton:hover {
    background: #333;
    border: 1px solid #555;
}

QFrame#rulerToolbar QPushButton:checked {
    background: #007ACC;
    border: 1px solid #007ACC;
}

#OCRWindow_itemList {
    background: #222;
    border: 1px solid #333;
    border-radius: 4px;
    color: #ddd;
}

#OCRWindow_itemList::item {
    height: 32px;
    padding-left: 5px;
}

#OCRWindow_itemList::item:selected {
    background: #3e3e42;
    color: white;
    border-radius: 2px;
}

#SettingsWindow QListWidget#SettingsNavBar {
    background-color: #1E1E1E;
    border: none;
    border-right: 1px solid #333333;
    outline: none;
    padding: 0px;
}

#SettingsWindow QListWidget#SettingsNavBar::item {
    height: 40px;
    min-height: 40px;
    max-height: 40px;
    padding-left: 16px;
    color: #AAAAAA;
