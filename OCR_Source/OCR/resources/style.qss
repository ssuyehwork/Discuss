}

#SettingsWindow QLineEdit#SettingsPathEdit {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 13px;
}

#SettingsWindow QLineEdit#HotkeyKeyEdit {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 0 8px;
    font-size: 13px;
    font-family: Consolas, 'Segoe UI', monospace;
