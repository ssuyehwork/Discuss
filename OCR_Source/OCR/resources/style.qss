}

QSlider#SizeSlider {
    background: transparent;
    margin-right: 5px;
}

QSlider#SizeSlider::groove:horizontal {
    height: 3px;
    background: #3F3F3F;
    border-radius: 2px;
}

QSlider#SizeSlider::sub-page:horizontal {
    background: #378ADD;
    border-radius: 2px;
}

QSlider#SizeSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    background: #8E8E93;
    border-radius: 5px;
    margin: -3px 0;
}

QSlider#SizeSlider::handle:horizontal:hover {
