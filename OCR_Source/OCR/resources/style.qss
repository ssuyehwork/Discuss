}

#SettingsWindow QPushButton#SettingsResetBtn {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: 1px solid #444444;
    border-radius: 4px;
    font-size: 12px;
}

#SettingsWindow QPushButton#SettingsResetBtn:hover {
    background-color: #3E3E42;
    color: #FFFFFF;
    border-color: #555555;
}

#SettingsWindow QPushButton#SettingsResetBtn:pressed {
    background-color: #252526;
}

#SettingsWindow QPushButton#SettingsSaveBtn {
    background-color: #3A90FF;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
}

#SettingsWindow QPushButton#SettingsSaveBtn:hover {
    background-color: #2B7AE6;
}

#SettingsWindow QPushButton#SettingsSaveBtn:pressed {
    background-color: #1A60C6;
}

#SettingsWindow QPushButton#SettingsBrowseBtn {
    background-color: #2D2D2D;
    color: #EEEEEE;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    font-size: 12px;
}

#SettingsWindow QPushButton#SettingsBrowseBtn:hover {
    background-color: #3E3E42;
    border-color: #555555;
}

#SettingsWindow QPushButton#SettingsBrowseBtn:pressed {
