}
QListWidget#FileDialogListView::item:hover {
    background-color: #2A2D2E;
}
QListWidget#FileDialogListView::item:selected {
    background-color: rgba(55, 138, 221, 0.3);
    color: #FFFFFF;
}

/* 全局通用 QPushButton 暗色兜底规整 (防止未带 objectName 的按钮回退 Windows 原生灰白，彻底去除 focus 虚线框) */
QPushButton {
    background-color: transparent;
    color: #EEEEEE;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
    outline: none;
}
QPushButton:focus {
    outline: none;
}
QPushButton:hover {
    background-color: #3E3E42;
    color: #FFFFFF;
    border-color: #555555;
}
QPushButton:pressed {
    background-color: #4E4E52;
}
QPushButton:disabled {
    background-color: #1E1E1E;
    color: #555555;
    border-color: #2D2D2D;
}

/* 统一 QTableWidget & QTableView & QHeaderView 表格组件暗色样式 */
QTableWidget, QTableView {
    background-color: #1E1E1E;
    alternate-background-color: #252526;
    color: #EEEEEE;
    gridline-color: #333333;
    border: 1px solid #333333;
    border-radius: 4px;
    outline: 0;
}
QTableWidget::item, QTableView::item {
    padding: 4px;
    border: none;
}
QTableWidget::item:hover, QTableView::item:hover {
    background-color: transparent;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: transparent;
    color: #EEEEEE;
}

QHeaderView {
    background-color: #252526;
    border: none;
}
QHeaderView::section {
    background-color: #252526;
    color: #888888;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #333333;
    border-bottom: 1px solid #333333;
    font-size: 12px;
    font-weight: bold;
}
QHeaderView::section:horizontal {
    border-top: none;
}
QHeaderView::section:last {
    border-right: none;
}
QLineEdit#FileDialogFileEdit, QComboBox#FileDialogFilterCombo {
    background: #1E1E1E;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    color: #EEEEEE;
    padding: 4px 8px;
    font-size: 12px;
}
QPushButton#FileDialogCancelBtn {
    background-color: transparent;
    border: 1px solid #444444;
    border-radius: 4px;
    color: #CCCCCC;
    padding: 6px 16px;
    font-size: 12px;
}
QPushButton#FileDialogCancelBtn:hover {
    background-color: #3E3E42;
    color: #FFFFFF;
}
QPushButton#FileDialogOkBtn {
    background-color: #3498db;
    border: none;
    border-radius: 4px;
    color: #FFFFFF;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: bold;
}
QPushButton#FileDialogOkBtn:hover {
    background-color: #2980b9;
}

QComboBox#RuleCombo {
    background: #1E1E1E;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 2px 5px;
    color: #EEE;
}
QComboBox#RuleCombo::drop-down {
    border: none;
    width: 20px;
}
QComboBox#RuleCombo QAbstractItemView {
    background-color: #2D2D2D;
    border: 1px solid #444;
    selection-background-color: #3E3E42;
    selection-color: white;
    color: #EEE;
    outline: 0;
}
QComboBox#RuleCombo QAbstractItemView::item {
    height: 22px;
    padding: 2px;
}
QLineEdit#RuleTextEdit, QSpinBox#RuleStartSpin {
