}
QListWidget#FileDialogSidebar {
    background-color: #252526;
    border: none;
    border-right: 1px solid #333333;
    color: #CCCCCC;
    outline: none;
}
QListWidget#FileDialogSidebar::item {
    height: 28px;
    padding-left: 8px;
    border-radius: 4px;
